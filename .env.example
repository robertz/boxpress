# For docker compose (docker-compose.yml). Copy to .env and fill it in.
# Everything in server/.env.example can go here too: the app reads this file.

# The address readers use, no trailing slash. Feeds, the sitemap, sharing
# cards and passkeys are built from it; passkeys can't move to another domain.
SITE_URL=https://blog.example.com
SITE_NAME=My Blog

# The database (created on first start)
MYSQL_DATABASE=boxpress
MYSQL_USER=boxpress
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Where the app listens on this host. 127.0.0.1 keeps it behind your proxy.
# APP_BIND=127.0.0.1
# APP_PORT=8080
# APP_MEMORY=1g
# APP_CPUS=2

# Behind a proxy that sets the visitor's address (X-Real-IP for nginx and
# Caddy, CF-Connecting-IP for Cloudflare), so sign-in rate limits are per visitor.
# TRUST_PROXY_HEADER=X-Real-IP
# CANONICAL_HOST_REDIRECT=true

# A new site starts with admin / admin (change it under Account; in production
# it can't sign in until given a password with scripts/users.bxs password admin). Set these
# before the first start to have your own admin in its place. Make the hash with:
#   docker compose run --rm app boxlang scripts/users.bxs hash
# (or skip these and run `docker compose exec app boxlang scripts/users.bxs add <name> <email> --admin`)
BOXPRESS_ADMIN_USERNAME=
BOXPRESS_ADMIN_EMAIL=
BOXPRESS_ADMIN_PASSWORD_HASH=

# Admins confirm with a passkey before using admin pages (on by default in production).
# ADMIN_PASSKEY_REQUIRED=true

# Optional: an S3-compatible bucket for uploads (R2, AWS S3, MinIO...).
# Without it, uploads are kept in the uploads volume and served at /uploads.
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.example.com

# Nightly database dumps into ./backups
# BACKUP_HOUR_UTC=8
# BACKUP_KEEP_DAYS=14
