/**
 * bx-passkeys' CredentialStore over our user_passkeys table (migrations/001_init.sql).
 */
class implements="bxModules.bxPasskeys.models.CredentialStore" {

	property name="db";

	static {
		COLUMNS = "credential_id, user_id, public_key, algorithm, sign_count, transports, name, created_at, last_used_at"
	}

	function init( required db ) {
		variables.db = arguments.db
		return this
	}

	function findByCredentialId( required string credentialId ) {
		var rows = variables.db.query( "SELECT #static.COLUMNS# FROM user_passkeys WHERE credential_id = ?", [ arguments.credentialId ], { returnType: "array" } )
		return rows.len() ? credentialOf( rows.first() ) : javacast( "null", "" )
	}

	array function listForUser( required string userId ) {
		return variables.db.query(
			"SELECT #static.COLUMNS# FROM user_passkeys WHERE user_id = ? ORDER BY id DESC",
			[ val( arguments.userId ) ],
			{ returnType: "array" }
		).map( ( r ) => credentialOf( r ) )
	}

	void function add( required struct credential ) {
		var c = arguments.credential
		variables.db.execute(
			"INSERT INTO user_passkeys ( user_id, credential_id, public_key, algorithm, sign_count, transports, name ) VALUES ( ?, ?, ?, ?, ?, ?, ? )",
			[ val( c.userId ), c.credentialId, c.publicKey, c.algorithm, c.signCount, c.transports.toList(), c.name ]
		)
	}

	// UTC_TIMESTAMP() rather than lastUsedAt: a datetime passed as a parameter shifts by the JVM's timezone.
	// Saves only while the counter is still ahead (or both are 0), so two sign-ins racing with one counter can't both pass.
	boolean function updateUsage( required string credentialId, required numeric signCount, required date lastUsedAt ) {
		var params = [ arguments.signCount, arguments.credentialId ]
		var guard = "sign_count = 0"
		if ( arguments.signCount > 0 ) {
			guard = "sign_count < ?"
			params.append( arguments.signCount )
		}
		return variables.db.execute(
			"UPDATE user_passkeys SET sign_count = ?, last_used_at = UTC_TIMESTAMP() WHERE credential_id = ? AND #guard#",
			params
		).recordCount > 0
	}

	boolean function remove( required string credentialId ) {
		return variables.db.execute( "DELETE FROM user_passkeys WHERE credential_id = ?", [ arguments.credentialId ] ).recordCount > 0
	}

	private struct function credentialOf( required struct r ) {
		return {
			credentialId : arguments.r.credential_id,
			userId       : toString( arguments.r.user_id ),
			publicKey    : arguments.r.public_key,
			algorithm    : arguments.r.algorithm,
			signCount    : arguments.r.sign_count,
			transports   : listToArray( arguments.r.transports ?: "" ),
			name         : arguments.r.name,
			createdAt    : arguments.r.created_at,
			lastUsedAt   : arguments.r.last_used_at ?: javacast( "null", "" )
		}
	}

}
