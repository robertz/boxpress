/**
 * Full collections counted by why they ran, from HotSpot's GC notifications.
 * "System.gc()" is an explicit request, such as the JDK reserving direct
 * buffer memory near MaxDirectMemorySize; "Allocation Failure" is the old
 * generation filling up. Counted since the process started, in its memory.
 */
class {

	// cause → { collections, timeMs } as AtomicLongs
	property name="causes";

	function init() {
		variables.causes = createObject( "java", "java.util.concurrent.ConcurrentHashMap" ).init()
		var listener = createDynamicProxy( this, [ "javax.management.NotificationListener" ] )
		var mgmt     = createObject( "java", "java.lang.management.ManagementFactory" )
		for ( var bean in mgmt.getGarbageCollectorMXBeans() ) {
			try {
				bean.addNotificationListener( listener, javaCast( "null", "" ), javaCast( "null", "" ) )
			} catch ( any e ) {
				// a collector that doesn't send notifications (not HotSpot)
			}
		}
		return this
	}

	/** The JVM calls this on its notification thread after every collection. */
	function handleNotification( notification, handback ) {
		try {
			if ( arguments.notification.getType() != "com.sun.management.gc.notification" ) {
				return
			}
			var info = createObject( "java", "com.sun.management.GarbageCollectionNotificationInfo" ).from( arguments.notification.getUserData() )
			if ( !findNoCase( "major", info.getGcAction() ) ) {
				return
			}
			var cause = info.getGcCause()
			variables.causes.putIfAbsent( cause, { collections: counter(), timeMs: counter() } )
			var entry = variables.causes.get( cause )
			entry.collections.incrementAndGet()
			entry.timeMs.addAndGet( info.getGcInfo().getDuration() )
		} catch ( any e ) {
			// an exception here would go to the JVM's notification thread
		}
	}

	/** [ { cause, collections, timeMs } ], most collections first. */
	array function current() {
		var result = []
		for ( var cause in variables.causes.keySet() ) {
			var entry = variables.causes.get( cause )
			result.append( { cause: cause, collections: entry.collections.get(), timeMs: entry.timeMs.get() } )
		}
		return result.sort( ( a, b ) => sgn( b.collections - a.collections ) )
	}

	private function counter() {
		return createObject( "java", "java.util.concurrent.atomic.AtomicLong" ).init( 0 )
	}

}
