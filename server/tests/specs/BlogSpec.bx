import tests.helpers.TestSupport;
import tests.helpers.ApiClient;
import routes.Api;

/** Signing in, writing and scheduling posts, and what the public site shows of them. */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.svc     = TestSupport::services()
		variables.port    = 4931
		variables.baseUrl = "http://127.0.0.1:#variables.port#"
		variables.app     = Api::build( variables.svc )
		variables.svc.monitor.attach( variables.app )
		variables.app.listen( port = variables.port, options = { block: false } )
	}

	function afterAll() {
		variables.app.close()
	}

	private function signedIn( string username = "" ) {
		var browser = new ApiClient( baseUrl )
		browser.login( len( username ) ? username : TestSupport::ADMIN_USER, TestSupport::TEST_PASSWORD )
		return browser
	}

	function run() {

		describe( "BoxPress", () => {

			beforeEach( () => TestSupport::resetDatabase( svc ) )

			describe( "Signing in", () => {

				it( "answers who is signed in, and refuses a wrong password", () => {
					var anonymous = new ApiClient( baseUrl )
					var sessionAnswer = anonymous.startSession()
					expect( sessionAnswer.status ).toBe( 200 )
					expect( sessionAnswer.json.authenticated ).toBeFalse()
					expect( sessionAnswer.json.csrfToken ).notToBe( "" )
					expect( anonymous.login( TestSupport::ADMIN_USER, "wrong-password" ).status ).toBe( 401 )
					expect( anonymous.get( "/api/posts" ).status ).toBe( 401 )

					var admin = signedIn()
					var me = admin.get( "/api/account" )
					expect( me.status ).toBe( 200 )
					expect( me.json.role ).toBe( "admin" )
					expect( me.json.isAdmin ).toBeTrue()
				} )

				it( "refuses a write without the CSRF token", () => {
					var admin = signedIn()
					expect( admin.post( "/api/posts", { title: "x" }, { "X-CSRF-Token": "" } ).status ).toBe( 403 )
				} )

				it( "keeps authors out of the admin's pages", () => {
					var author = signedIn( TestSupport::AUTHOR_USER )
					for ( var path in [ "/api/admin/users", "/api/admin/settings", "/api/admin/server", "/api/admin/insights/traffic", "/api/admin/requests" ] ) {
						expect( author.get( path ).status ).toBe( 403, path )
					}
				} )

				it( "asks an admin for a passkey when the site requires one", () => {
					var strict = TestSupport::services( { passkeys: { requiredForAdmins: true } } )
					var strictApp = Api::build( strict )
					strictApp.listen( port = 4932, options = { block: false } )
					try {
						var admin = new ApiClient( "http://127.0.0.1:4932" )
						admin.login( TestSupport::ADMIN_USER, TestSupport::TEST_PASSWORD )
						var answer = admin.get( "/api/admin/users" )
						expect( answer.status ).toBe( 403 )
						expect( answer.json.code ).toBe( "passkey_required" )
						expect( admin.get( "/api/account" ).json.adminNeedsPasskey ).toBeTrue()
					} finally {
						strictApp.close()
					}
				} )
			} )

			describe( "Posts", () => {

				it( "renders Markdown safely and builds a slug from the title", () => {
					var admin = signedIn()
					var created = admin.post( "/api/posts", {
						title  : "Hello, World!",
						body   : "Some **bold** text.#char( 10 )##char( 10 )#<script>alert(1)</script>#char( 10 )##char( 10 )#[out](https://example.com)",
						tags   : [ "BoxLang", "boxlang", "Web Dev" ],
						status : "published"
					} )
					expect( created.status ).toBe( 201, created.body )
					expect( created.json.slug ).toBe( "hello-world" )
					expect( created.json.status ).toBe( "published" )
					expect( created.json.html ).toInclude( "<strong>bold</strong>" )
					expect( created.json.html ).notToInclude( "<script" )
					expect( created.json.html ).toInclude( 'target="_blank"' )
					expect( created.json.excerpt ).toBe( "Some bold text. out" )
					expect( created.json.tags.map( ( t ) => t.slug ) ).toBe( [ "boxlang", "web-dev" ] )

					var again = admin.post( "/api/posts", { title: "Hello, World!", body: "dupe" } )
					expect( again.json.slug ).toBe( "hello-world-2" )
					expect( again.json.status ).toBe( "draft" )
				} )

				it( "shows a published post on the site, and not a draft or a scheduled one", () => {
					var admin = signedIn()
					admin.post( "/api/posts", { title: "Live post", body: "Live words.", status: "published", tags: [ "News" ] } )
					admin.post( "/api/posts", { title: "Draft post", body: "Not yet." } )
					admin.post( "/api/posts", { title: "Later post", body: "Soon.", status: "published", publishedAt: "2099-01-01T00:00:00Z" } )

					var reader = new ApiClient( baseUrl )
					expect( reader.get( "/posts/live-post" ).status ).toBe( 200 )
					expect( reader.get( "/posts/draft-post" ).status ).toBe( 404 )
					expect( reader.get( "/posts/later-post" ).status ).toBe( 404 )
					var home = reader.get( "/" )
					expect( home.status ).toBe( 200 )
					expect( home.body ).toInclude( "Live post" )
					expect( home.body ).notToInclude( "Draft post" )
					expect( home.body ).notToInclude( "Later post" )
					expect( reader.get( "/tag/news" ).status ).toBe( 200 )
					expect( reader.get( "/tag/nothing" ).status ).toBe( 404 )
					expect( reader.get( "/author/#TestSupport::ADMIN_USER#" ).body ).toInclude( "Live post" )
					// a reader leaves no session behind
					expect( svc.db.query( "SELECT COUNT(*) AS n FROM sessions WHERE data NOT LIKE '%userId%'" ).n ).toBe( 0 )

					var scheduled = admin.get( "/api/posts?status=scheduled" )
					expect( scheduled.json.posts.map( ( p ) => p.title ) ).toBe( [ "Later post" ] )
				} )

				it( "lets an author change only their own posts", () => {
					var admin = signedIn()
					var adminPost = admin.post( "/api/posts", { title: "Admin's post", body: "x" } ).json
					var author = signedIn( TestSupport::AUTHOR_USER )
					var own = author.post( "/api/posts", { title: "Writer's post", body: "y" } )
					expect( own.status ).toBe( 201 )
					expect( author.put( "/api/posts/#own.json.id#", { title: "Writer's post, edited" } ).json.title ).toBe( "Writer's post, edited" )
					expect( author.put( "/api/posts/#adminPost.id#", { title: "Mine now" } ).status ).toBe( 403 )
					expect( author.delete( "/api/posts/#adminPost.id#" ).status ).toBe( 403 )
					expect( author.get( "/api/posts" ).json.posts.map( ( p ) => p.title ) ).toBe( [ "Writer's post, edited" ] )
					expect( admin.delete( "/api/posts/#own.json.id#" ).status ).toBe( 204 )
				} )

				it( "keeps a history of saves, and one autosave", () => {
					var admin = signedIn()
					var post = admin.post( "/api/posts", { title: "Versions", body: "one" } ).json
					admin.put( "/api/posts/#post.id#", { body: "two" } )
					admin.put( "/api/posts/#post.id#", { body: "two" } )
					admin.put( "/api/posts/#post.id#/autosave", { title: "Versions", body: "three, unsaved" } )
					var history = admin.get( "/api/posts/#post.id#/revisions" ).json
					expect( history.map( ( r ) => r.kind ) ).toBe( [ "autosave", "save", "save" ] )
					var autosave = admin.get( "/api/posts/#post.id#/revisions/#history[ 1 ].id#" ).json
					expect( autosave.body ).toBe( "three, unsaved" )
					expect( admin.get( "/api/posts/#post.id#" ).json.body ).toBe( "two" )
				} )

				it( "finds posts by search, and logs what readers looked for", () => {
					var admin = signedIn()
					admin.post( "/api/posts", { title: "Virtual threads in practice", body: "Concurrency without callbacks.", status: "published" } )
					admin.post( "/api/posts", { title: "Something else", body: "Unrelated.", status: "published" } )
					var reader = new ApiClient( baseUrl )
					var found = reader.get( "/search?q=concurrency" )
					expect( found.status ).toBe( 200 )
					expect( found.body ).toInclude( "Virtual threads in practice" )
					expect( found.body ).notToInclude( "Something else" )
					expect( reader.get( "/search?q=xyzzy" ).body ).toInclude( "Nothing matched" )
					var searches = admin.get( "/api/admin/insights/audience" ).json
					expect( searches.zeroSearches.map( ( s ) => s.label ) ).toInclude( "xyzzy" )
				} )
			} )

			describe( "Feeds", () => {

				it( "lists public posts in the feed and sitemap, with absolute addresses", () => {
					var admin = signedIn()
					admin.post( "/api/posts", { title: "Feed me", body: "![pic](/uploads/a.png)", status: "published" } )
					admin.post( "/api/posts", { title: "Hidden draft", body: "x" } )
					var reader = new ApiClient( baseUrl )
					var feed = reader.get( "/feed.xml" )
					expect( feed.status ).toBe( 200 )
					expect( isXML( feed.body ) ).toBeTrue()
					expect( feed.body ).toInclude( "<link>http://blog.example.test/posts/feed-me</link>" )
					expect( feed.body ).toInclude( "http://blog.example.test/uploads/a.png" )
					expect( feed.body ).notToInclude( "Hidden draft" )
					var sitemap = reader.get( "/sitemap.xml" )
					expect( isXML( sitemap.body ) ).toBeTrue()
					expect( sitemap.body ).toInclude( "http://blog.example.test/posts/feed-me" )
					expect( reader.get( "/robots.txt" ).body ).toInclude( "Sitemap: http://blog.example.test/sitemap.xml" )
				} )
			} )

			describe( "Media and settings", () => {

				it( "takes an image upload, and refuses what isn't one", () => {
					var author = signedIn( TestSupport::AUTHOR_USER )
					var uploaded = author.post( "/api/media?name=pic.png", TestSupport::png( 64, 48 ), { "Content-Type": "image/png" } )
					expect( uploaded.status ).toBe( 201, uploaded.body )
					expect( uploaded.json.width ).toBe( 64 )
					expect( uploaded.json.url ).toInclude( "https://cdn.example/media/" )
					expect( author.post( "/api/media?name=x.png", "not an image", { "Content-Type": "image/png" } ).status ).toBe( 400 )
					expect( author.get( "/api/media" ).json.total ).toBe( 1 )
					var admin = signedIn()
					admin.post( "/api/posts", { title: "Uses it", body: "![x](#uploaded.json.url#)" } )
					expect( admin.delete( "/api/media/#uploaded.json.id#" ).status ).toBe( 409 )
					expect( admin.delete( "/api/media/#uploaded.json.id#?force=true" ).status ).toBe( 204 )
				} )

				it( "saves site settings and shows them on the site", () => {
					var admin = signedIn()
					expect( admin.put( "/api/admin/settings", { postsPerPage: 0 } ).status ).toBe( 400 )
					var saved = admin.put( "/api/admin/settings", { title: "My Notebook", tagline: "Notes on things", accentColor: "##ff5500" } )
					expect( saved.status ).toBe( 200, saved.body )
					var reader = new ApiClient( baseUrl )
					expect( reader.get( "/" ).body ).toInclude( "My Notebook" )
					expect( reader.get( "/theme.css" ).body ).toInclude( "##ff5500" )
				} )

				it( "manages accounts, and won't leave the site without an admin", () => {
					var admin = signedIn()
					var created = admin.post( "/api/admin/users", { username: "newbie", email: "newbie@example.test", password: "long-enough-1", role: "author" } )
					expect( created.status ).toBe( 201, created.body )
					expect( new ApiClient( baseUrl ).login( "newbie", "long-enough-1" ).status ).toBe( 200 )
					expect( admin.patch( "/api/admin/users/#created.json.id#", { disabled: true } ).json.disabled ).toBeTrue()
					expect( new ApiClient( baseUrl ).login( "newbie", "long-enough-1" ).status ).toBe( 401 )
					expect( admin.patch( "/api/admin/users/#TestSupport::userId( svc )#", { role: "author" } ).status ).toBe( 400 )
					expect( admin.delete( "/api/admin/users/#created.json.id#" ).status ).toBe( 204 )
				} )
			} )

			describe( "Server metrics", () => {

				it( "shows admins the running server, and records it hourly", () => {
					var admin = signedIn()
					admin.get( "/api/posts" )
					var answer = admin.get( "/api/admin/server" )
					expect( answer.status ).toBe( 200, answer.body )
					var snap = answer.json.snapshot
					expect( snap.memory.heapUsed ).toBeGT( 0 )
					expect( snap.threads.live ).toBeGT( 0 )
					expect( snap.mysql.version ).notToBe( "" )
					expect( snap.routes.map( ( r ) => r.route ) ).toInclude( "GET /api/posts" )
					expect( answer.json.history ).toBe( [] )
					svc.history.record()
					expect( admin.get( "/api/admin/server" ).json.history.len() ).toBe( 1 )
				} )
			} )

			describe( "Review fixes", () => {

				it( "refuses the default admin / admin sign-in in production", () => {
					svc.db.execute( "DELETE FROM users WHERE username = 'admin'" )
					svc.db.execute(
						"INSERT INTO users ( username, email, password_hash, role ) VALUES ( 'admin', 'admin@example.com', ?, 'admin' )",
						[ bcryptHash( "admin" ) ]
					)
					var prod = TestSupport::services( { server: { production: true } } )
					var prodApp = Api::build( prod )
					prodApp.listen( port = 4933, options = { block: false } )
					try {
						var answer = new ApiClient( "http://127.0.0.1:4933" ).login( "admin", "admin" )
						expect( answer.status ).toBe( 403, answer.body )
						expect( answer.json.message ).toInclude( "scripts/users.bxs password admin" )
					} finally {
						prodApp.close()
					}
					// outside production it still signs in, for a first look
					expect( new ApiClient( baseUrl ).login( "admin", "admin" ).status ).toBe( 200 )
				} )

				it( "ends a passkey's confirmation in every session once the passkey is removed", () => {
					var strict = TestSupport::services( { passkeys: { requiredForAdmins: true } } )
					var userId = TestSupport::userId( svc )
					svc.db.execute(
						"INSERT INTO user_passkeys ( user_id, credential_id, public_key, algorithm, name ) VALUES ( ?, 'cred-1', 'key', -7, 'Laptop' )",
						[ userId ]
					)
					var stolen = { userId: userId, passkey: "cred-1" }
					expect( strict.passkeys.adminAllowed( stolen ) ).toBeTrue()
					expect( strict.passkeys.adminAllowed( { userId: userId, passkey: true } ) ).toBeFalse()
					expect( strict.passkeys.adminAllowed( { userId: TestSupport::userId( svc, TestSupport::AUTHOR_USER ), passkey: "cred-1" } ) ).toBeFalse()
					svc.db.execute( "DELETE FROM user_passkeys WHERE credential_id = 'cred-1'" )
					expect( strict.passkeys.adminAllowed( stolen ) ).toBeFalse()
				} )

				it( "shows an author the top posts of their own, public, posts only", () => {
					var admin = signedIn()
					var adminPost = admin.post( "/api/posts", { title: "Admin hit", body: "x", status: "published" } ).json
					var author = signedIn( TestSupport::AUTHOR_USER )
					var own = author.post( "/api/posts", { title: "Writer hit", body: "y", status: "published" } ).json
					svc.posts.recordView( adminPost.id )
					svc.posts.recordView( own.id )
					expect( author.get( "/api/dashboard/top-posts" ).json.map( ( p ) => p.label ) ).toBe( [ "Writer hit" ] )
					expect( admin.get( "/api/dashboard/top-posts" ).json.len() ).toBe( 2 )
					admin.put( "/api/posts/#adminPost.id#", { status: "draft" } )
					expect( admin.get( "/api/dashboard/top-posts" ).json.map( ( p ) => p.label ) ).toBe( [ "Writer hit" ] )
				} )

				it( "leaves bots' searches out of the log, and prunes old ones", () => {
					var reader = new ApiClient( baseUrl )
					reader.send( "GET", "/search?q=botquery", "", { "User-Agent": "Googlebot/2.1" } )
					reader.get( "/search?q=personquery" )
					var logged = svc.db.query( "SELECT query FROM search_log", [], { returnType: "array" } ).map( ( r ) => r.query )
					expect( logged ).toBe( [ "personquery" ] )
					svc.db.execute( "UPDATE search_log SET searched_at = DATE_SUB( UTC_TIMESTAMP(), INTERVAL 400 DAY )" )
					svc.requestLog.prune()
					expect( svc.db.query( "SELECT COUNT(*) AS n FROM search_log" ).n ).toBe( 0 )
				} )

				it( "lets an admin delete or demote a disabled admin while one admin is left", () => {
					var admin = signedIn()
					var second = admin.post( "/api/admin/users", { username: "second", email: "second@example.test", password: "long-enough-1", role: "admin" } ).json
					expect( admin.patch( "/api/admin/users/#second.id#", { disabled: true } ).status ).toBe( 200 )
					expect( admin.patch( "/api/admin/users/#second.id#", { role: "author" } ).status ).toBe( 200 )
					expect( admin.patch( "/api/admin/users/#second.id#", { role: "admin" } ).status ).toBe( 200 )
					expect( admin.delete( "/api/admin/users/#second.id#" ).status ).toBe( 204 )
				} )

				it( "changes nothing when one field of an account edit fails", () => {
					var admin = signedIn()
					var writerId = TestSupport::userId( svc, TestSupport::AUTHOR_USER )
					var answer = admin.patch( "/api/admin/users/#writerId#", { role: "admin", displayName: "Renamed", password: "short" } )
					expect( answer.status ).toBe( 400 )
					var writer = svc.users.get( writerId )
					expect( writer.role ).toBe( "author" )
					expect( writer.display_name ).toBe( "Test Writer" )
				} )

				it( "compares the last 30 days of views with the 30 before", () => {
					for ( var i = 1; i <= 70; i++ ) {
						svc.db.execute(
							"INSERT INTO request_log_daily ( log_date, kind, name, hits ) VALUES ( DATE_SUB( UTC_DATE(), INTERVAL ? DAY ), 'pageviews', '', 100 )",
							[ i ]
						)
					}
					var traffic = signedIn().get( "/api/admin/insights/traffic" ).json
					expect( traffic.days.len() ).toBe( 30 )
					// 29 full days and today, which has no views yet
					expect( traffic.total ).toBe( 2900 )
					expect( traffic.previousTotal ).toBe( 3000 )
				} )

				it( "writes every queued request to the access log in one flush", () => {
					var reader = new ApiClient( baseUrl )
					for ( var i = 1; i <= 30; i++ ) {
						reader.get( "/tags" )
					}
					var written = svc.requestLog.flush()
					expect( written ).toBeGTE( 30 )
					expect( svc.db.query( "SELECT COUNT(*) AS n FROM request_log WHERE path = '/tags'" ).n ).toBe( 30 )
					expect( svc.requestLog.queued() ).toBe( 0 )
				} )

				it( "keeps size words that are part of an image caption", () => {
					var html = svc.markdown.render( '![x](/a.png "caption: A wide river at dusk")' ).html
					expect( html ).notToInclude( "post-figure--wide" )
					expect( html ).toInclude( "<figcaption>A wide river at dusk</figcaption>" )
					expect( svc.markdown.render( '![x](/a.png "half | The logo")' ).html ).toInclude( "post-figure--half" )
					expect( svc.markdown.render( '![x](/a.png "inline")' ).html ).notToInclude( "<figure" )
				} )
			} )

			describe( "Second review fixes", () => {

				it( "counts only what it's told to, per key, and forgets a key when cleared", () => {
					var throttle = new services.Throttle( 60000, 2 )
					expect( throttle.allowed( "a" ) ).toBeTrue()
					expect( throttle.take( "a" ) ).toBeTrue()
					expect( throttle.take( "a" ) ).toBeTrue()
					expect( throttle.allowed( "a" ) ).toBeFalse()
					expect( throttle.take( "a" ) ).toBeFalse()
					expect( throttle.allowed( "b" ) ).toBeTrue()
					expect( throttle.retryAfter( "a" ) ).toBeGT( 0 )
					throttle.clear( "a" )
					expect( throttle.allowed( "a" ) ).toBeTrue()
				} )

				it( "keeps passkey sign-in requests off the password sign-in limit", () => {
					var strict = TestSupport::services( { auth: { maxLoginAttempts: 2 } } )
					var strictApp = Api::build( strict )
					strictApp.listen( port = 4934, options = { block: false } )
					try {
						var browser = new ApiClient( "http://127.0.0.1:4934" )
						browser.startSession()
						for ( var i = 1; i <= 3; i++ ) {
							expect( browser.post( "/api/auth/passkey/options", {} ).status ).toBe( 200 )
						}
						expect( browser.login( TestSupport::ADMIN_USER, TestSupport::TEST_PASSWORD ).status ).toBe( 200 )
					} finally {
						strictApp.close()
					}
				} )

				it( "saves a post, its tags and its revision together, or none of them", () => {
					var failing = {
						snapshot : ( postId, userId ) => {
							throw( type = "Probe.Failed", message = "revision store down" )
						}
					}
					var fragile = new services.Posts( svc.db, svc.markdown, svc.tags, failing, svc.users, "" )
					expect( () => fragile.create( TestSupport::userId( svc ), { title: "Half saved", body: "x", tags: [ "Orphan" ] } ) ).toThrow( "Probe.Failed" )
					expect( svc.db.query( "SELECT COUNT(*) AS n FROM posts" ).n ).toBe( 0 )
					expect( svc.db.query( "SELECT COUNT(*) AS n FROM tags" ).n ).toBe( 0 )

					var saved = svc.posts.create( TestSupport::userId( svc ), { title: "Whole", body: "x", tags: [ "Kept" ] } )
					expect( () => fragile.update( saved.id, TestSupport::userId( svc ), { title: "Changed", tags: [ "Other" ] } ) ).toThrow( "Probe.Failed" )
					var after = svc.posts.get( saved.id )
					expect( after.title ).toBe( "Whole" )
					expect( after.tags.map( ( t ) => t.name ) ).toBe( [ "Kept" ] )
				} )

				it( "prunes old referrer and 404 summaries, and keeps each day's page views", () => {
					for ( var kind in [ "pageviews", "404", "referrer" ] ) {
						svc.db.execute(
							"INSERT INTO request_log_daily ( log_date, kind, name, hits ) VALUES ( DATE_SUB( UTC_DATE(), INTERVAL 400 DAY ), ?, ?, 1 )",
							[ kind, kind == "pageviews" ? "" : "/wp-login.php" ]
						)
					}
					svc.requestLog.prune()
					expect( svc.db.query( "SELECT kind FROM request_log_daily", [], { returnType: "array" } ).map( ( r ) => r.kind ) ).toBe( [ "pageviews" ] )
				} )

				it( "gives page 2 of a listing its own canonical address", () => {
					svc.site.save( { postsPerPage: 1 } )
					try {
						var admin = signedIn()
						admin.post( "/api/posts", { title: "First", body: "x", status: "published", publishedAt: "2026-01-01T00:00:00Z" } )
						admin.post( "/api/posts", { title: "Second", body: "x", status: "published", publishedAt: "2026-01-02T00:00:00Z" } )
						var reader = new ApiClient( baseUrl )
						expect( reader.get( "/?page=2" ).body ).toInclude( 'rel="canonical" href="http&##x3a;&##x2f;&##x2f;blog.example.test&##x2f;&##x3f;page&##x3d;2"' )
						expect( reader.get( "/" ).body ).toInclude( 'rel="canonical" href="http&##x3a;&##x2f;&##x2f;blog.example.test&##x2f;"' )
					} finally {
						svc.site.save( { postsPerPage: 10 } )
					}
				} )

				it( "answers too many searches with the site's own page", () => {
					var strict = TestSupport::services( { limits: { searchesPerMinute: 2 } } )
					var strictApp = Api::build( strict )
					strictApp.listen( port = 4935, options = { block: false } )
					try {
						var reader = new ApiClient( "http://127.0.0.1:4935" )
						expect( reader.get( "/search?q=one" ).status ).toBe( 200 )
						expect( reader.get( "/search?q=two" ).status ).toBe( 200 )
						var refused = reader.get( "/search?q=three" )
						expect( refused.status ).toBe( 429 )
						expect( refused.body ).toInclude( "Too many searches" )
						expect( refused.body ).toInclude( "<html" )
					} finally {
						strictApp.close()
					}
				} )

				it( "keeps ids on headings only, away from the layout's own", () => {
					var html = svc.markdown.render( '<p id="bp-main">x</p>' & char( 10 ) & char( 10 ) & "## Main" ).html
					expect( html ).notToInclude( 'id="bp-main"' )
					expect( html ).toInclude( ' id="main">Main</h' )
				} )
			} )
		} )
	}

}
