<bx:include template="_head.bxm">
<bx:output>
<div class="wrap">
	<header class="page-header">
		<h1 class="page-header__title">Authors</h1>
	</header>
	<bx:if data.authors.len()>
	<ul class="author-list">
		<bx:loop array="#data.authors#" item="author">
		<li class="author-card">
			<bx:if len( author.avatarUrl )>
			<img class="author-card__avatar" src="#encodeForHTMLAttribute( author.avatarUrl )#" alt="">
			<bx:else>
			<span class="author-card__avatar" aria-hidden="true">#encodeForHTML( author.initials )#</span>
			</bx:if>
			<div>
				<p class="author-card__name"><a href="/author/#encodeForURL( author.username )#">#encodeForHTML( author.displayName )#</a></p>
				<p class="author-card__bio">#author.postCount# #author.postCount == 1 ? "post" : "posts"#<bx:if len( author.bio )> &middot; #encodeForHTML( left( author.bio, 160 ) )#</bx:if></p>
			</div>
		</li>
		</bx:loop>
	</ul>
	<bx:else>
	<p class="empty">No one has published yet.</p>
	</bx:if>
</div>
</bx:output>
<bx:include template="_foot.bxm">
