<bx:include template="_head.bxm">
<bx:output>
<div class="wrap wrap--narrow">
	<header class="page-head">
		<h1 class="page-head__title">Authors</h1>
		<p class="page-head__lede">Everyone who has published here.</p>
	</header>
	<bx:if data.authors.len()>
	<div class="row-list">
		<bx:loop array="#data.authors#" item="author">
		<article class="row">
			<bx:if len( author.avatarUrl )>
			<img class="avatar" src="#encodeForHTMLAttribute( author.avatarUrl )#" alt="" width="56" height="56" loading="lazy">
			<bx:else>
			<span class="avatar" aria-hidden="true">#encodeForHTML( author.initials )#</span>
			</bx:if>
			<div>
				<h2 class="row__name"><a href="/author/#encodeForURL( author.username )#">#encodeForHTML( author.displayName )#</a></h2>
				<bx:if len( author.bio )><p class="row__text">#encodeForHTML( author.bio )#</p></bx:if>
				<p class="row__meta">#author.postCount# #author.postCount == 1 ? "post" : "posts"#</p>
			</div>
		</article>
		</bx:loop>
	</div>
	<bx:else>
	<p class="empty">No one has published yet.</p>
	</bx:if>
</div>
</bx:output>
<bx:include template="_foot.bxm">
