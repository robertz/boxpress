<bx:output><!doctype html>
<html lang="#encodeForHTMLAttribute( data.site.language )#">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>#encodeForHTML( len( data.pageTitle ?: "" ) ? data.pageTitle & " · " & data.site.title : data.site.title & ( len( data.site.tagline ) ? " · " & data.site.tagline : "" ) )#</title>
<bx:if len( data.description ?: "" )>
<meta name="description" content="#encodeForHTMLAttribute( data.description )#">
</bx:if>
<meta name="robots" content="#encodeForHTMLAttribute( data.robots )#">
<link rel="canonical" href="#encodeForHTMLAttribute( data.canonicalUrl )#">
<link rel="alternate" type="application/rss+xml" title="#encodeForHTMLAttribute( data.site.title )#" href="/feed.xml">
<meta property="og:site_name" content="#encodeForHTMLAttribute( data.site.title )#">
<meta property="og:type" content="#encodeForHTMLAttribute( data.ogType )#">
<meta property="og:title" content="#encodeForHTMLAttribute( len( data.pageTitle ?: "" ) ? data.pageTitle : data.site.title )#">
<meta property="og:url" content="#encodeForHTMLAttribute( data.canonicalUrl )#">
<bx:if len( data.description ?: "" )>
<meta property="og:description" content="#encodeForHTMLAttribute( data.description )#">
</bx:if>
<bx:if len( data.ogImage ?: "" )>
<meta property="og:image" content="#encodeForHTMLAttribute( data.ogImage )#">
<meta name="twitter:card" content="summary_large_image">
<bx:else>
<meta name="twitter:card" content="summary">
</bx:if>
<bx:if structKeyExists( data, "post" )>
<meta property="article:published_time" content="#encodeForHTMLAttribute( data.post.publishedAt )#">
<meta property="article:modified_time" content="#encodeForHTMLAttribute( data.post.updatedAt )#">
<bx:loop array="#data.post.tags#" item="headTag">
<meta property="article:tag" content="#encodeForHTMLAttribute( headTag.name )#">
</bx:loop>
</bx:if>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<bx:if len( data.siteCss ?: "" )>
<link rel="stylesheet" href="#data.siteCss#">
</bx:if>
<link rel="stylesheet" href="/theme.css">
<bx:if len( data.siteJs ?: "" )>
<script type="module" src="#data.siteJs#"></script>
</bx:if>
</head>
<body>
<bx:set navPath = data.currentPath>
<bx:set navWriting = navPath == "/" || left( navPath, 7 ) == "/posts/" || navPath == "/search">
<bx:set navTags = navPath == "/tags" || left( navPath, 5 ) == "/tag/">
<bx:set navAuthors = navPath == "/authors" || left( navPath, 8 ) == "/author/">
<a class="skip-link" href="##bp-main">Skip to content</a>
<header class="site-header">
	<div class="wrap site-header__inner">
		<a href="/" class="site-header__logo">#encodeForHTML( data.site.title )#</a>
		<nav class="site-header__nav" aria-label="Sections">
			<a href="/" class="site-header__link" #navWriting ? 'aria-current="page"' : ''#>Writing</a>
			<a href="/tags" class="site-header__link" #navTags ? 'aria-current="page"' : ''#>Tags</a>
			<a href="/authors" class="site-header__link" #navAuthors ? 'aria-current="page"' : ''#>Authors</a>
		</nav>
		<div class="site-header__spacer"></div>
		<div class="site-header__actions">
			<a href="/search" class="icon-button" aria-label="Search posts"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></a>
			<a href="/feed.xml" class="icon-button" aria-label="RSS feed"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor"/></svg></a>
			<button type="button" class="icon-button site-header__menu" aria-label="Open menu" aria-expanded="false" aria-controls="bp-menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
		</div>
	</div>
	<div class="mobile-menu" id="bp-menu" hidden>
		<form class="search-box search-box--menu" method="get" action="/search" role="search">
			<label class="visually-hidden" for="bp-menu-search">Search posts</label>
			<input id="bp-menu-search" class="search-box__input" type="search" name="q" placeholder="Search posts">
		</form>
		<nav class="mobile-menu__links" aria-label="Sections">
			<a href="/" class="mobile-menu__link">Writing</a>
			<a href="/tags" class="mobile-menu__link">Tags</a>
			<a href="/authors" class="mobile-menu__link">Authors</a>
			<a href="/feed.xml" class="mobile-menu__link">RSS feed</a>
		</nav>
	</div>
</header>
<main id="bp-main" tabindex="-1">
</bx:output>
