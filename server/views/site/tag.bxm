<bx:include template="_head.bxm">
<bx:output>
<div class="wrap">
	<header class="page-header">
		<p class="page-header__kicker"><a href="/tags">Tags</a></p>
		<h1 class="page-header__title">#encodeForHTML( data.tag.name )#</h1>
		<p class="page-header__meta">#data.paging.total# #data.paging.total == 1 ? "post" : "posts"#</p>
	</header>
	<div class="post-list">
		<bx:loop array="#data.paging.posts#" item="post">
			<bx:include template="_postCard.bxm">
		</bx:loop>
	</div>
	<bx:include template="_pagination.bxm">
</div>
</bx:output>
<bx:include template="_foot.bxm">
