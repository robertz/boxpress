<bx:include template="_head.bxm">
<bx:output>
<bx:set firstPage = data.paging.page == 1>
<div class="wrap wrap--narrow">

	<bx:if firstPage>
	<section class="intro">
		<h1 class="intro__title">#encodeForHTML( len( data.site.tagline ) ? data.site.tagline : data.site.title )#</h1>
		<bx:if len( data.site.description )><p class="intro__lede">#encodeForHTML( data.site.description )#</p></bx:if>
	</section>
	<bx:else>
	<h1 class="visually-hidden">#encodeForHTML( data.site.title )#, page #data.paging.page#</h1>
	</bx:if>

	<bx:if data.featured.len()>
	<section class="home-block" aria-labelledby="bp-featured-heading">
		<div class="block-head">
			<h2 id="bp-featured-heading" class="block-head__title">Featured</h2>
		</div>
		<div class="feature-list">
			<bx:loop array="#data.featured#" item="post">
				<bx:include template="_postFeature.bxm">
			</bx:loop>
		</div>
	</section>
	</bx:if>

	<section class="home-block" aria-labelledby="bp-recent-heading">
		<div class="block-head">
			<h2 id="bp-recent-heading" class="block-head__title">#firstPage ? "Recent writing" : "Writing &middot; page #data.paging.page# of #data.paging.totalPages#"#</h2>
			<a href="/feed.xml" class="block-head__more">RSS &rarr;</a>
		</div>
		<bx:if data.paging.posts.len()>
		<div class="entry-list">
			<bx:loop array="#data.paging.posts#" item="post">
				<bx:include template="_postEntry.bxm">
			</bx:loop>
		</div>
		<bx:include template="_pagination.bxm">
		<bx:else>
		<p class="empty">Nothing here yet. Sign in at <a href="/admin">/admin</a> to write the first post.</p>
		</bx:if>
	</section>

	<bx:if data.topTags.len()>
	<section class="home-block" aria-labelledby="bp-topics-heading">
		<div class="block-head">
			<h2 id="bp-topics-heading" class="block-head__title">Topics</h2>
			<a href="/tags" class="block-head__more">All topics &rarr;</a>
		</div>
		<nav class="topic-row" aria-label="Topics">
			<bx:loop array="#data.topTags#" item="tag">
				<a href="/tag/#encodeForURL( tag.slug )#" class="topic-row__link">#encodeForHTML( tag.name )# <span>#tag.posts#</span></a>
			</bx:loop>
		</nav>
	</section>
	</bx:if>

</div>
</bx:output>
<bx:include template="_foot.bxm">
