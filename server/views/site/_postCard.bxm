<bx:output>
<article class="post-card">
	<bx:if len( post.coverImage )>
	<a href="#encodeForHTMLAttribute( post.url )#" class="post-card__cover" tabindex="-1" aria-hidden="true">
		<img src="#encodeForHTMLAttribute( post.coverImage )#" alt="" loading="lazy" decoding="async">
	</a>
	</bx:if>
	<div class="post-card__body">
		<bx:if post.tags.len()>
		<p class="post-card__tags">
			<bx:loop array="#post.tags#" item="cardTag" index="cardTagIndex">
				<bx:if cardTagIndex lte 3><a href="/tag/#encodeForURL( cardTag.slug )#">#encodeForHTML( cardTag.name )#</a></bx:if>
			</bx:loop>
		</p>
		</bx:if>
		<h2 class="post-card__title"><a href="#encodeForHTMLAttribute( post.url )#">#encodeForHTML( post.title )#</a></h2>
		<bx:if len( post.excerpt )>
		<p class="post-card__excerpt">#encodeForHTML( post.excerpt )#</p>
		</bx:if>
		<p class="post-meta">
			<a href="/author/#encodeForURL( post.author.username )#">#encodeForHTML( post.author.displayName )#</a>
			<span aria-hidden="true">&middot;</span>
			<time datetime="#encodeForHTMLAttribute( post.publishedAt )#">#post.dateLabel#</time>
			<span aria-hidden="true">&middot;</span>
			<span>#post.readingMinutes# min read</span>
		</p>
	</div>
</article>
</bx:output>
