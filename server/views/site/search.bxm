<bx:include template="_head.bxm">
<bx:output>
<div class="wrap">
	<header class="page-header">
		<h1 class="page-header__title">Search</h1>
		<form class="search-form" method="get" action="/search" role="search">
			<label class="visually-hidden" for="bp-search-posts">Search posts</label>
			<input id="bp-search-posts" type="search" name="q" value="#encodeForHTMLAttribute( data.query )#" placeholder="Search posts" autofocus>
			<button type="submit">Search</button>
		</form>
		<bx:if len( data.query )>
		<p class="page-header__meta">#data.paging.total# #data.paging.total == 1 ? "result" : "results"# for &ldquo;#encodeForHTML( data.query )#&rdquo;</p>
		</bx:if>
	</header>
	<bx:if data.paging.posts.len()>
	<div class="post-list">
		<bx:loop array="#data.paging.posts#" item="post">
			<bx:include template="_postCard.bxm">
		</bx:loop>
	</div>
	<bx:include template="_pagination.bxm">
	<bx:elseif len( data.query )>
	<p class="empty">Nothing matched. Try fewer or different words.</p>
	</bx:if>
</div>
</bx:output>
<bx:include template="_foot.bxm">
