<bx:output>
</main>
<footer class="site-footer">
	<div class="wrap site-footer__inner">
		<p>#len( data.site.footerText ) ? encodeForHTML( data.site.footerText ) : "&copy; " & year( now() ) & " " & encodeForHTML( data.site.title )#</p>
		<p class="site-footer__follow">Follow by <a href="/feed.xml">RSS</a></p>
		<nav class="site-footer__links" aria-label="Elsewhere">
			<a href="/tags">Tags</a>
			<a href="/authors">Authors</a>
			<a href="https://github.com/robertz/boxpress">Powered by BoxPress</a>
		</nav>
	</div>
</footer>
</body>
</html>
</bx:output>
