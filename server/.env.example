# Copy to server/.env for local development. BoxLang (1.18+) reads .env and
# .boxlang.json from the directory it's started in, so run from server/.

# development | production. Production turns on Secure cookies, HSTS and
# (by default) passkeys for admins.
ENV=development
PORT=8080
# Logs each request to the console (BoxExpress); the access log for Insights is separate.
REQUEST_LOG=true
# The site's public address, no trailing slash. Feeds, the sitemap, sharing
# cards and passkeys are built from it.
SITE_URL=http://localhost:8080
# The site's title until an admin sets one in Admin > Settings.
SITE_NAME=BoxPress
# Where the built web app is; defaults to ../web/dist.
# WEB_ROOT=
# Behind a proxy that sets the client's address in a header (X-Real-IP,
# CF-Connecting-IP), name it here so rate limits are per visitor. Only when
# the app can't be reached any other way: anyone else could forge it.
# TRUST_PROXY_HEADER=
# In production, redirect requests for any other host to SITE_URL's.
# CANONICAL_HOST_REDIRECT=false

# The MySQL 8 connection (.boxlang.json reads these). A schema per
# environment: boxpress_development here, your own name in production, and
# boxpress_test for the specs (always, whatever this says).
BOXPRESS_DB_HOST=127.0.0.1
BOXPRESS_DB_PORT=3306
BOXPRESS_DB_NAME=boxpress_development
BOXPRESS_DB_USER=root
BOXPRESS_DB_PASSWORD=

# A new site starts with admin / admin (change it under Account). Set these
# before the first start to have your own admin in its place; ignored once
# the default password has been changed or another account exists.
# Make the hash with: boxlang scripts/users.bxs hash
BOXPRESS_ADMIN_USERNAME=
BOXPRESS_ADMIN_EMAIL=
BOXPRESS_ADMIN_PASSWORD_HASH=

# SESSION_DAYS=30
# MAX_LOGIN_ATTEMPTS=10

# Passkeys belong to a domain for good: SITE_URL's host by default.
# PASSKEY_RP_ID=localhost
# An admin's powers need a session that signed in, or confirmed, with a
# passkey. On by default in production only.
# ADMIN_PASSKEY_REQUIRED=false

# Uploaded images go to an S3-compatible bucket when all of these are set
# (Cloudflare R2, AWS S3, MinIO, Backblaze B2...), served from
# S3_PUBLIC_BASE_URL. Otherwise they're files in UPLOADS_DIR (server/uploads),
# served at /uploads.
#   R2:  S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com  S3_REGION=auto
#   AWS: S3_ENDPOINT=https://s3.us-east-1.amazonaws.com             S3_REGION=us-east-1
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# UPLOAD_PREFIX=media
# UPLOADS_DIR=
# UPLOAD_MAX_MB=10
# UPLOADS_PER_HOUR=200

# How long the access log behind Insights keeps raw requests. Daily summaries are kept for good.
# REQUEST_LOG_DAYS=90
