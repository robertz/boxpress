root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{bx,bxs,bxm,cfc,cfm,sql,graphqls}]
indent_style = tab

[Dockerfile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{ts,tsx,css,html,json}]
indent_style = tab
